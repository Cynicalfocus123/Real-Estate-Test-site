Options -MultiViews
RewriteEngine On

# Keep the admin URL clean. Hostinger serves the real Vite entry file internally.
RewriteRule ^admin/?$ admin.html [END]

# Never send API or uploaded-media requests to the SPA. Their same-origin routing
# is a Hostinger/server responsibility; this frontend rule cannot configure it.
RewriteRule ^(?:api/v1|uploads)(?:/|$) - [END]

# Preserve real files and directories, then serve the public SPA for its
# history routes (properties, account/auth pages, browse routes, and articles).
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [END]
RewriteRule ^ index.html [END]
